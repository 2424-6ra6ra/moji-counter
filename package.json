{
  "name": "moji-counter",
  "version": "0.1.0",
  "description": "日本語の文字数を grapheme（人間が見える文字単位）で正確にカウントする TypeScript ライブラリ",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "japanese",
    "grapheme",
    "character-count",
    "intl-segmenter",
    "text-length"
  ],
  "author": "Nishimura Yoshitaka",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
